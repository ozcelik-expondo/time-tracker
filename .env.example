# Jira Cloud configuration
# Leave these unset if you want to run the tracker without Jira sync.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token
# Stop the running timer after this many minutes without keyboard/mouse input (macOS only).
# Active video calls count as activity. Set to 0 to disable.
IDLE_AUTO_PAUSE_MINUTES=30
